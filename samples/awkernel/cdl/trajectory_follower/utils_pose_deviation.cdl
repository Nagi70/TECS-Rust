signature sUtilsPoseDeviation {
    double64_t calcLateralDeviation([in] const struct Pose* base_pose,
                              [in] PLType("&nalgebra::Vector3<f64>") target_point);
    double64_t calcYawDeviation([in] const struct Pose* base_pose,
                          [in] const struct Pose* target_pose);
};

[generate(RustAWKPlugin, "")]
celltype tUtilsPoseDeviation {
    entry sUtilsPoseDeviation eUtils;
};